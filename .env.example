# --- Environnement ---
# development (par défaut) ou production. En production, Authentification,
# Room-Service, Message-Service et User-Config-Service REFUSENT de démarrer
# si un secret est absent, trop court ou égal à une valeur de développement
# de ce fichier (JWT_SECRET, INTERNAL_SERVICE_TOKEN, mots de passe PostgreSQL
# et Redis ci-dessous). Générer de vraies valeurs, par ex. :
#   openssl rand -hex 32
NODE_ENV=development

# Utilisateur Linux qui possède .env (bootstrap Docker). Adapter hors UID/GID 1000.
LOCAL_UID=1000
LOCAL_GID=1000

# ⚠️ Identifiants réservés au développement local : ne jamais les réutiliser
# dans un environnement partagé ou de production. Copier vers `.env`
# (cp .env.example .env) ; `.env` ne doit jamais être commité.
# Une seule déclaration par variable : si une clé est répétée, la dernière gagne.

# --- PostgreSQL (superutilisateur) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=postgres

# --- Bases logiques et comptes SQL (un compte par service) ---
AUTH_DB=chatvardage_auth
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=auth_service_dev

ROOMS_DB=chatvardage_rooms
ROOMS_DB_USER=room_service
ROOMS_DB_PASSWORD=room_service_dev

MESSAGES_DB=chatvardage_messages
MESSAGES_DB_USER=message_service
MESSAGES_DB_PASSWORD=message_service_dev

CONFIG_DB=chatvardage_config
CONFIG_DB_USER=config_service
CONFIG_DB_PASSWORD=config_service_dev

# --- Redis ---
REDIS_PASSWORD=chatvardage_redis_dev

# --- Auth-Service ---
# Auth-Service uniquement : utilisé pour signer et vérifier les JWT.
# Au moins 32 caractères, sinon Auth-Service refuse de démarrer.
# Room-Service et Message-Service valident les jetons via Auth-Service /api/auth/me.
JWT_SECRET=dev_secret_change_me_before_prod
JWT_DUREE_DE_VIE_HEURES=24

# Délai d'appel à Auth-Service depuis Room-Service et Message-Service.
AUTH_SERVICE_TIMEOUT_MS=3000
# Durée (ms) pendant laquelle Room-Service, Message-Service et Serveur-API
# (routes User-Config) mémorisent un
# jeton validé. Une révocation ou un changement de rôle est pris en compte au
# plus tard après ce délai. 0 = appel à Auth-Service à chaque requête.
AUTH_CACHE_TTL_MS=10000

# Secret partagé entre microservices : routes /api/internal/* (droits des
# salons, événements temps réel, effacement des données d'un compte ou d'un
# salon supprimé) et x-user-id posé par Serveur-API pour User-Config. Lu par
# tous les services sauf le Dashboard. À changer hors développement, par ex. :
# openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=chatvardage_internal_dev
ROOM_SERVICE_TIMEOUT_MS=3000
# Durée (ms) pendant laquelle Message-Service mémorise un droit d'accès à un
# salon (vidé dès qu'un serveur change). 0 = pas de cache.
ROOM_ACCESS_CACHE_TTL_MS=10000

# --- CORS ---
# Origines séparées par des virgules, lues sous ce même nom par tous les
# services (Auth-Service compris).
CORS_ORIGINS=http://localhost:5173

# --- Serveur-API ---
# Boucle locale par défaut. Exposition LAN volontaire : 0.0.0.0 en développement.
# En production, garder 127.0.0.1 derrière un reverse proxy HTTPS contrôlé.
API_BIND_ADDRESS=127.0.0.1
PROXY_TIMEOUT_MS=5000
MAX_PROXY_BODY_BYTES=1048576
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
TRUST_PROXY=false

# --- Dashboard ---
# Secret de cookie AdminJS. Au moins 32 caracteres hors developpement local.
DASHBOARD_COOKIE_SECRET=dashboard_cookie_secret_for_local_development

# Secret de signature des sessions HTTP du Dashboard uniquement.
# Généré automatiquement par scripts/generer-env.sh au premier docker compose up.
# Volontairement vide ici : aucun secret de session public. Au moins 32 caractères
# et distinct de DASHBOARD_COOKIE_SECRET.
DASHBOARD_SESSION_SECRET=
